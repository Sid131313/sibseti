Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Keep local development unaffected; canonicalize only the production host.
RewriteCond %{HTTP_HOST} ^www\.sibirset-connect\.ru$ [NC]
RewriteRule ^ https://sibirset-connect.ru%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^sibirset-connect\.ru$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://sibirset-connect.ru%{REQUEST_URI} [R=301,L]

RewriteRule ^([a-z0-9-]+)/index\.html$ /$1/ [R=301,L]

# Add the canonical trailing slash only for existing city directories.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^([a-z0-9-]+)$ /$1/ [R=301,L]

# Keep operational files private; final JSON in /data/tariffs/ stays public for the frontend.
RewriteRule ^(?:parser|logs|data/(?:source|overrides|manual|backups|status))/ - [F,L,NC]
<FilesMatch "(?:\.lock|\.tmp|config\.php)$">
  Require all denied
</FilesMatch>

# Static assets are versioned in HTML. Update ?v=... when CSS or JS changes.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|jpg|jpeg|png|webp|svg|webm|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:html|json|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
